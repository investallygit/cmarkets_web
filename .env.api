# Mode "api" (npm run dev:api): the dev server on a CMarket.Api running on this machine
# (dotnet run --project src/CMarket.Api --launch-profile http, in the API's repository).
# Read after .env; .env.api.local overrides it on one machine.

VITE_USE_MOCKS=false

# The API's development tools give the demo accounts, the codes and the account switch.
VITE_DEV_TOOLS=true

# The dev server forwards /api and /hubs to the API, so the site and the API share one origin
# and the session cookie works as in production: leave VITE_API_URL empty here.
DEV_PROXY_TARGET=http://localhost:5001
