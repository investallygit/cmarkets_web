# Defaults of every mode. Override locally in .env.local (not committed).

# true: every API call and real-time event is served by src/mocks, no back end needed.
VITE_USE_MOCKS=true

# Origin of CMarket.Api (spec section 10), such as https://api.cmarket.example: the REST API
# (/api/v1) and the SignalR hubs (/hubs/market, /hubs/chat) are served under it. Empty: the
# site's own origin, as through the dev server's proxy below or a reverse proxy.
# In development, go through the proxy rather than set this: a site on localhost calling an API
# on another site does not keep the API's session cookie.
VITE_API_URL=

# Each address can also be set on its own; empty: derived from VITE_API_URL.
# VITE_API_BASE_URL=/api/v1
# VITE_REALTIME_HUB_URL=/hubs/market
# VITE_CHAT_HUB_URL=/hubs/chat

# Dev server only: forward /api and /hubs to a running back end (used when VITE_USE_MOCKS=false).
# DEV_PROXY_TARGET=http://localhost:5001
