# Prototype defaults. Override locally in .env.local (not committed).

# CMarket REST API (CMarket.Api) and SignalR hub, spec section 10.
VITE_API_BASE_URL=/api/v1
VITE_REALTIME_HUB_URL=/hubs/market

# true: every API call and real-time event is served by src/mocks, no back end needed.
VITE_USE_MOCKS=true

# Dev server only: forward /api and /hubs to a running back end (used when VITE_USE_MOCKS=false).
# DEV_PROXY_TARGET=https://localhost:7001
